{
  "schemaVersion": "1.0.0",
  "id": "JJAJANGNARA_PLATFORM_ONBOARDING_DNA_V1",
  "phase": "A",
  "status": "PREPARE_ONLY",
  "productTemplate": {
    "id": "restaurant-delivery-template",
    "vertical": "restaurant",
    "instance": "JJAJANGNARA",
