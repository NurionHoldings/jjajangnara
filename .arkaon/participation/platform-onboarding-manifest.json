      "menuSyncSource": "netlify/functions/_menu-catalog.js",
      "envRequired": [
        "AIBAEBY_MERCHANT_DRAFT_URL",
        "AIBAEBY_TEMPLATE_BIND_URL",
        "AIBAEBY_AFFILIATE_CONNECTOR_SECRET"
      ],
      "notes": "draft=신규, template-bind=기존 업체 실연동 + participation 능력치. 정산 HQ."
    }
